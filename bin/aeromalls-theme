#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Execute every Magento and npm operation as PHP-FPM's filesystem user.
run() { docker compose exec -T -u www-data php-fpm "$@"; }
run sh -c 'for path in generated pub/static var/view_preprocessed app/etc app/design/frontend/Aeromalls/aeromalls/web; do if [ ! -w "$path" ]; then printf "Not writable by www-data: %s\n" "$path" >&2; exit 1; fi; done'
case "${1:-build}" in
 build)
  run sh -c 'cd app/design/frontend/Aeromalls/aeromalls/web/tailwind && npm ci --cache /tmp/aeromalls-npm-cache --no-audit --no-fund && npm run build'
  run sh -c 'target=pub/static/frontend/Aeromalls/aeromalls/en_US/css/styles.css; if [ -f "$target" ]; then test -w "$target" && cp app/design/frontend/Aeromalls/aeromalls/web/css/styles.css "$target"; fi'
  ;;
 deploy)
  run bin/magento setup:di:compile
  run bin/magento setup:static-content:deploy -f en_US
  run bin/magento cache:clean config layout block_html full_page
  ;;
 status)
  run bin/magento module:status Aeromalls_Storefront
  run bin/magento setup:db:status
  run sh -c 'stat -c "%U:%G %a %n" app/design/frontend/Aeromalls/aeromalls/web/css/styles.css generated pub/static var/view_preprocessed'
  ;;
 *) printf 'Usage: %s {build|deploy|status}\n' "$0" >&2; exit 2 ;;
esac

run sh -c 'for path in generated pub/static var/view_preprocessed app/design/frontend/Aeromalls/aeromalls/web/css/styles.css; do test -w "$path" || exit 1; stat -c "%U:%G %a %n" "$path"; done'
