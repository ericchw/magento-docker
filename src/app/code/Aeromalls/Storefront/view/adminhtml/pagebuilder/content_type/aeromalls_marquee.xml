<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_PageBuilder:etc/content_type.xsd">
 <type name="aeromalls_marquee" label="Brand Logo Marquee" component="Magento_PageBuilder/js/content-type-collection" preview_component="Aeromalls_Storefront/js/content-type/marquee/preview" master_component="Magento_PageBuilder/js/content-type/master-collection" form="pagebuilder_aeromalls_marquee_form" menu_section="elements" icon="icon-pagebuilder-text" sortOrder="75" translate="label">
  <parents default_policy="deny"><parent name="root-container" policy="allow"/><parent name="row" policy="allow"/><parent name="column" policy="allow"/><parent name="tab-item" policy="allow"/></parents>
  <children default_policy="deny"><child name="image" policy="allow"/></children>
  <appearances><appearance name="default" default="true" preview_template="Aeromalls_Storefront/content-type/marquee/default/preview" master_template="Aeromalls_Storefront/content-type/marquee/default/master" reader="Magento_PageBuilder/js/master-format/read/configurable">
