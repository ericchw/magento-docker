<?php
/** @var \Magento\Framework\Escaper $escaper */
$vm = $block instanceof \Aeromalls\Storefront\Block\Content ? $block->vm() : $viewModels->require(\Aeromalls\Storefront\ViewModel\Storefront::class);
?>
<?php $promo = $vm->promo();
if (!$promo) {
    return;
} $modal = $viewModels->require(\Hyva\Theme\ViewModel\Modal::class)->createModal()->withDialogRefName('aero-promo')->withAriaLabel($vm->value('promo/title'))->withCloseby($vm->value('promo/close_backdrop') === '1' ? 'any' : 'closerequest')->withTemplate('Aeromalls_Storefront::promo-content.phtml'); ?>
<div x-data="aeroPromo" data-promo="<?= $escaper->escapeHtmlAttr(json_encode($promo)) ?>"><?= $modal ?></div>
<script>
window.addEventListener('alpine:init',()=>Alpine.data('aeroPromo',()=>({
 closePromo(event){event.currentTarget.closest('dialog')?.close();},
 init(){const c=JSON.parse(this.$el.dataset.promo);const dialog=this.$root.querySelector('dialog');let cancelled=false;
 window.addEventListener('aero-overlay-open',()=>cancelled=true,{once:true});window.addEventListener('toggle-cart',()=>cancelled=true,{once:true});
 setTimeout(()=>{const now=Date.now()/1000; if(cancelled||(c.start&&now<c.start)||(c.end&&now>=c.end)||document.querySelector('dialog[open], [aria-haspopup][aria-expanded="true"], details[data-nav-details][open]')||document.activeElement?.matches('input,textarea,select')||document.querySelector('#search[aria-expanded="true"]'))return;
 const key='aeromalls-promo-'+c.store+'-'+c.id;try{const storage=c.frequency==='24h'?localStorage:sessionStorage;const seen=Number(storage.getItem(key));if(seen&&(c.frequency!=='24h'||Date.now()-seen<86400000))return;storage.setItem(key,String(Date.now()));}catch(e){}
 dialog?.showModal(); if(c.end)setTimeout(()=>dialog.close(),Math.min(2147483647,Math.max(0,c.end*1000-Date.now())));
 },c.delay);
 }
})),{once:true});
</script><?php $hyvaCsp->registerInlineScript() ?>
