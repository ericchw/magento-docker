<?php
/** @var \Magento\Framework\Escaper $escaper */
$vm = $block instanceof \Aeromalls\Storefront\Block\Content ? $block->vm() : $viewModels->require(\Aeromalls\Storefront\ViewModel\Storefront::class);
?>
<div class="aero-search" x-data="aeroSearch" data-endpoint="<?= $escaper->escapeUrl($vm->route('aeromalls_search/suggest')) ?>" data-min="<?= $vm->minLength() ?>" data-delay="<?= max(100, min(1000, (int)$vm->value('search/debounce', '250'))) ?>" data-enabled="<?= $vm->enabled('search/enabled') ? '1' : '0' ?>" data-limit="<?= max(1, min(10, (int)$vm->value('search/limit', '6'))) ?>">
<form role="search" method="get" action="<?= $escaper->escapeUrl($vm->route('catalogsearch/result')) ?>" class="flex" @submit="submit"><label class="sr-only" for="search"><?= $escaper->escapeHtml(__('Search products, SKU or MPN')) ?></label><input class="form-input w-full min-w-0 rounded-r-none" id="search" name="q" type="search" maxlength="128" placeholder="<?= $escaper->escapeHtmlAttr(__('Search products, SKU or MPN')) ?>" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="aero-search-results" aria-expanded="false" :aria-expanded="open" :aria-activedescendant="activeId" @input="input" @compositionstart="compositionStart" @compositionend="compositionEnd" @keydown="keydown" @focus="focus" x-ref="input"><button class="btn btn-primary rounded-l-none shrink-0" type="submit" aria-label="<?= $escaper->escapeHtmlAttr(__('Search')) ?>" title="<?= $escaper->escapeHtmlAttr(__('Search')) ?>"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></button></form>
<div class="aero-search-results" x-show="open" x-cloak @click.outside="close" id="aero-search-results"><p class="p-3" x-show="items.length === 0" x-text="statusText"></p><div role="listbox" aria-label="<?= $escaper->escapeHtmlAttr(__('Search suggestions')) ?>">
<template x-for="(item,index) in items" :key="item.key"><a :href="item.url" role="option" :id="item.key" :aria-selected="index === active" @mousemove="select" @click="close"><img x-show="item.image" :src="item.image" :alt="item.name" width="56" height="56"><span class="grow"><span class="block font-semibold" x-text="item.name"></span><span class="block text-sm text-slate-500" x-text="item.meta"></span></span><span class="text-sm font-semibold" x-text="item.price"></span></a></template></div><a x-show="allUrl" :href="allUrl" class="font-semibold border-t"><?= $escaper->escapeHtml(__('View all results')) ?></a></div>
<p class="sr-only" role="status" aria-live="polite" x-text="statusText"></p></div>
<script>
window.addEventListener('alpine:init',()=>Alpine.data('aeroSearch',()=>({
 items:[],open:false,active:-1,allUrl:'',state:'idle',composing:false,timer:null,controller:null,sequence:0,
 init(){window.addEventListener('aero-overlay-open',()=>this.close());window.addEventListener('toggle-cart',()=>this.close());},
 get activeId(){return this.active>=0?this.items[this.active]?.key:null;},
 get isSelected(){return this.index===this.active;},
 get statusText(){return this.state==='loading'?'<?= $escaper->escapeJs(__('Searching')) ?>':this.state==='error'?'<?= $escaper->escapeJs(__('Search preview unavailable. Press Enter to search.')) ?>':this.state==='no-results'?'<?= $escaper->escapeJs(__('No products found.')) ?>':this.state==='success'?hyva.str('<?= $escaper->escapeJs(__('%1 suggestions available')) ?>',this.items.length):'';},
 compositionStart(){this.composing=true;clearTimeout(this.timer);this.controller?.abort();this.sequence++;},
 compositionEnd(){this.composing=false;this.input();},
 input(){clearTimeout(this.timer);this.controller?.abort();const seq=++this.sequence;const q=this.$refs.input.value.trim();this.active=-1;this.open=false;this.allUrl='';if(this.composing||this.$root.dataset.enabled!=='1'||Array.from(q).length<Number(this.$root.dataset.min)){this.items=[];this.state='idle';return;}this.state='loading';this.timer=setTimeout(()=>this.fetch(q,seq),Number(this.$root.dataset.delay));},
 async fetch(q,seq){const controller=new AbortController();this.controller=controller;const abort=setTimeout(()=>controller.abort(),5000);try{const u=new URL(this.$root.dataset.endpoint,location.href);u.searchParams.set('q',q);u.searchParams.set('limit',this.$root.dataset.limit);const r=await fetch(u,{signal:controller.signal,credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}});if(!r.ok)throw new Error('preview');const data=await r.json();if(seq!==this.sequence)return;
 this.items=[...data.suggestions.map((s,i)=>({key:'aero-keyword-'+i,url:s.url,name:s.label,meta:'',price:'',image:''})),...data.items.map(p=>({key:'aero-product-'+p.id,url:p.url,name:p.name,meta:[p.sku,p.mpn].filter(Boolean).join(' · '),image:p.image.url,price:p.price.tax_display==='both'?p.price.formatted_final+' <?= $escaper->escapeJs(__('Incl. Tax')) ?> / '+p.price.formatted_excluding_tax+' <?= $escaper->escapeJs(__('Excl. Tax')) ?>':p.price.formatted_final}))];this.allUrl=data.all_results_url;this.state=this.items.length?'success':'no-results';this.open=true;
 }catch(e){if(seq===this.sequence){this.state='error';this.items=[];this.open=true;}}finally{clearTimeout(abort);}},
 focus(){if(this.items.length)this.open=true;},select(){this.active=this.index;},
 close(){clearTimeout(this.timer);this.controller?.abort();this.sequence++;this.open=false;this.active=-1;},
 keydown(e){if(e.isComposing||this.composing)return;if(e.key==='Escape'){this.close();return;}if(e.key==='Tab'){this.close();return;}if(!this.open||!this.items.length)return;if(e.key==='ArrowDown'){e.preventDefault();this.active=(this.active+1)%this.items.length;}if(e.key==='ArrowUp'){e.preventDefault();this.active=(this.active-1+this.items.length)%this.items.length;}if(this.active>=0)document.getElementById(this.activeId)?.scrollIntoView({block:'nearest'});},
 submit(e){if(this.composing){e.preventDefault();return;}if(this.open&&this.active>=0){e.preventDefault();location.assign(this.items[this.active].url);}}
})),{once:true});
</script><?php $hyvaCsp->registerInlineScript() ?>
