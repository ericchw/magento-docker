<?php
/** @var \Magento\Framework\Escaper $escaper */
$vm = $block instanceof \Aeromalls\Storefront\Block\Content ? $block->vm() : $viewModels->require(\Aeromalls\Storefront\ViewModel\Storefront::class);
?>
<footer class="aero-footer"><div class="container"><div class="aero-footer-grid"><section><h2 class="text-2xl font-semibold mb-4"><?= $escaper->escapeHtml($vm->value('general/brand', 'Aeromalls')) ?></h2><?= /* @noEscape */ $block->cms('footer/about_block') ?></section><?php if ($vm->links() || $vm->value('footer/links_block')): ?><section><h2 class="text-lg font-semibold mb-4"><?= $escaper->escapeHtml(__('Support & information')) ?></h2><?= /* @noEscape */ $block->cms('footer/links_block') ?><?php foreach ($vm->links() as $link): ?><a class="block py-2" href="<?= $escaper->escapeUrl($link['url']) ?>"><?= $escaper->escapeHtml(__($link['label'])) ?></a><?php endforeach ?></section><?php endif ?><?php if (array_filter(array_map(fn ($key) => $vm->contact($key), ['phone','street_line1','street_line2','city','postcode','hours']))): ?><section><h2 class="text-lg font-semibold mb-4"><?= $escaper->escapeHtml(__('Contact')) ?></h2><?php if ($phone = $vm->contact('phone')): ?><a class="block py-2" href="tel:<?= $escaper->escapeHtmlAttr(preg_replace('/[^+0-9]/', '', $phone)) ?>"><?= $escaper->escapeHtml($phone) ?></a><?php endif ?><?php foreach (['street_line1','street_line2','city','postcode','hours'] as $key): ?><?php if ($text = $vm->contact($key)): ?><p class="py-1"><?= $escaper->escapeHtml($text) ?></p><?php endif ?><?php endforeach ?></section><?php endif ?></div><div class="border-t border-slate-700 mt-8 pt-6 text-sm">© <?= (int)date('Y') ?> <?= $escaper->escapeHtml($vm->value('general/brand', 'Aeromalls')) ?></div></div></footer>
